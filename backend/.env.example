# ---------------------------------------------------------------------------
# Gaon Saathi backend configuration
# Copy to .env (or run `python -m app.cli init-env`, which also generates
# the secrets). NEVER commit .env to git.
# ---------------------------------------------------------------------------

# development | production | test
APP_ENV=development

# PostgreSQL is recommended (required in production). Examples:
#   DATABASE_URL=postgresql+psycopg://gaon_app:CHANGE_ME@localhost:5432/gaon_saathi
# If not set, a local SQLite file (backend/data/gaon_saathi.db) is used for development.
# DATABASE_URL=

# --- Secrets (generated by `python -m app.cli init-env`) -------------------
# >= 32 random characters. Used for HMAC of tracking codes, sessions, anti-spam.
SECRET_KEY=
# base64 of exactly 32 random bytes. Encrypts complaint text and evidence files.
# BACK THIS UP SECURELY: losing it makes stored complaints unreadable.
DATA_ENCRYPTION_KEY=

# --- Evidence storage -------------------------------------------------------
# local (private folder outside the web root) or s3 (private bucket)
STORAGE_BACKEND=local
# EVIDENCE_DIR=./storage/evidence
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ENDPOINT_URL=
# S3_PREFIX=evidence/

# --- Upload limits ----------------------------------------------------------
MAX_FILES_PER_SUBMISSION=5
MAX_IMAGE_MB=10
MAX_PDF_MB=10
MAX_VIDEO_MB=50
MAX_TOTAL_UPLOAD_MB=80

# --- Optional malware scanning (ClamAV daemon) ------------------------------
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310

# --- Optional explicit ffmpeg path (for removing video metadata) -------------
# FFMPEG_PATH=

# --- Anti-spam ----------------------------------------------------------------
POW_DIFFICULTY=16
RATE_LIMIT_ENABLED=true
# Set true ONLY behind your own reverse proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# --- Admin sessions -------------------------------------------------------------
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# Defaults to true in production. Must be true when served over HTTPS.
# COOKIE_SECURE=false

# --- HTTP -------------------------------------------------------------------------
# Enable once the site is served over HTTPS.
HSTS_ENABLED=false
# API docs at /api/docs (defaults: on in development, off in production)
# ENABLE_API_DOCS=false
SERVE_FRONTEND=true

# --- Optional public support contact shown on the Contact page ---------------------
# SUPPORT_EMAIL=
# SUPPORT_PHONE=
