# Gaon Saathi - example nginx reverse proxy (HTTPS, privacy-preserving).
# Replace gaonsaathi.example.org with your domain and obtain a certificate
# (for example with certbot). Backend runs on 127.0.0.1:8000 and serves the
# built React app as well as the API.

# Privacy: do not write visitor IP addresses to access logs.
log_format gaon_privacy '[$time_local] $request_method $status $body_bytes_sent';

server {
    listen 80;
    listen [::]:80;
    server_name gaonsaathi.example.org;
    access_log off;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name gaonsaathi.example.org;

    ssl_certificate     /etc/letsencrypt/live/gaonsaathi.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gaonsaathi.example.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_tickets off;

    # No IPs or URLs (URLs can contain complaint IDs) in logs.
    access_log off;
    error_log /var/log/nginx/gaon_saathi_error.log crit;

    server_tokens off;
    client_max_body_size 85m;          # must be >= MAX_TOTAL_UPLOAD_MB (+ form overhead)
    client_body_timeout 300s;          # slow rural uploads
    proxy_read_timeout 300s;
    proxy_request_buffering on;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Only used (in memory, hashed) for rate limiting when TRUST_PROXY_HEADERS=true.
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
